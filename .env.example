# QuantumLab configuration (copy to .env and adjust; all optional).
# The application requires NO external API keys -- every result comes
# from local simulation.

# Path to the SQLite database file (default: backend/quantumlab.db).
QUANTUMLAB_DB=backend/quantumlab.db

# Comma-separated CORS origins allowed by the API (defaults to the
# local vite dev servers: localhost:5173 / 127.0.0.1:5173 / :4173).
# Extend when running the frontend on a nonstandard port.
QUANTUMLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
